# Collabuild MAS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Cloud LLM Providers ──────────────────────────────────────

# OpenRouter (https://openrouter.ai) — 200+ models, free tier
OPENROUTER_API_KEY=

# NVIDIA Build (https://build.nvidia.com) — 160+ open models
NVIDIA_API_KEY=

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ── Baidu OCR ────────────────────────────────────────────────

# Baidu OCR (https://cloud.baidu.com/product/ocr)
# Free tiers: 200 pages/doc parsing, 1000 calls/month general OCR
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ── Bhashini AI (Indian Languages) ────────────────────────────

# Bhashini (भाषिणी) — India's National Language Translation Mission
# Provides translation, transliteration, TTS, ASR for 22+ Indian languages
# Sign up: https://bhashini.gov.in/ulca/user/signup
BHASHINI_API_KEY=

# ── Local Providers (no API key needed) ─────────────────────

# Ollama — run `ollama serve` locally (default: http://localhost:11434)
# KoboldCPP — run KoboldCPP server (default: http://localhost:5001)
# text-generation-webui — run oobabooga (default: http://localhost:5000)
