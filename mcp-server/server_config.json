    {
      "method": "get",
      "path": "/api/tools/status"
    },
    {
      "method": "post",
      "path": "/api/tools/ocr"
    },
    {
      "method": "post",
      "path": "/api/tools/web-fetch"
    },
    {
      "method": "post",
      "path": "/api/tools/agent-run"
    },
    {
      "method": "post",
      "path": "/api/devsrs/build"
    }
