{
  "app": {
    "name": "Collabuild",
    "version": "unknown",
    "description": "A MAS implementation of research paper to prototype builder"
  },
  "stack": "python",
  "routes": [
    {
      "method": "get",
      "path": "/"
    },
    {
      "method": "get",
      "path": "/api/health"
    },
    {
      "method": "get",
      "path": "/api/capabilities"
    },
    {
      "method": "post",
      "path": "/api/run/{capability}"
    },
    {
      "method": "post",
      "path": "/api/agents/kickoff"
    },
    {
      "method": "post",
      "path": "/api/upload"
    },
    {
      "method": "post",
      "path": "/api/parse/{doc_id}"
    },
    {
      "method": "get",
      "path": "/settings"
    },
    {
      "method": "get",
      "path": "/pipeline"
    },
    {
      "method": "post",
      "path": "/api/chat"
    },
    {
      "method": "post",
      "path": "/api/chat/sync"
    },
    {
      "method": "get",
      "path": "/api/settings"
    },
    {
      "method": "post",
      "path": "/api/settings"
    },
    {
      "method": "get",
      "path": "/api/models"
    },
    {
      "method": "get",
      "path": "/api/local-models"
    },
    {
      "method": "get",
      "path": "/api/providers/status"
    },
    {
